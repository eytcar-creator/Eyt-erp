# E.Y.T ERP production API
# Docker Compose services must use the internal service hostname "db".
# For a host-run local Python process, use localhost instead of db.
DATABASE_URL=postgresql://eyt_user:change_me@db:5432/eyt_erp

# Authentication: replace every placeholder with a separate strong random secret.
JWT_SECRET=replace_with_a_long_random_secret
BOOTSTRAP_SECRET=replace_with_a_separate_bootstrap_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional CORS configuration. Use only trusted, actual origins.
CORS_ORIGINS=http://localhost:3000

# E.Y.T One Channel Hub
CHANNEL_INTAKE_SECRET=replace_with_channel_hmac_secret
EYT_ERP_CHANNEL_TOKEN=replace_with_internal_n8n_channel_token

# n8n Automation Hub (only needed when starting the automation profile)
N8N_ENCRYPTION_KEY=replace_with_a_long_random_n8n_key
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
EYT_ERP_API_BASE_URL=http://api:8000
GENERIC_TIMEZONE=Asia/Tehran

# Required by docker-compose.production.yml
POSTGRES_DB=eyt_erp
POSTGRES_USER=eyt_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
RUBIKA_WORKSHOP_WEBHOOK_SECRET=replace_with_a_strong_rubika_webhook_secret
