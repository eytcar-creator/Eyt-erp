# E.Y.T ERP production API
DATABASE_URL=postgresql://eyt_user:change_me@localhost:5432/eyt_erp

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
BOOTSTRAP_SECRET=replace_with_a_separate_bootstrap_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional CORS configuration
CORS_ORIGINS=http://localhost:3000

# E.Y.T One Channel Hub
CHANNEL_INTAKE_SECRET=replace_with_channel_hmac_secret
EYT_ERP_CHANNEL_TOKEN=replace_with_internal_n8n_channel_token

# n8n Automation Hub
N8N_ENCRYPTION_KEY=replace_with_a_long_random_n8n_key
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
EYT_ERP_API_BASE_URL=https://api.example.com
GENERIC_TIMEZONE=Asia/Tehran
