# PostgreSQL
POSTGRES_DB=eyt_erp
POSTGRES_USER=eyt_user
POSTGRES_PASSWORD=replace_with_a_strong_secret

# API connection string
DATABASE_URL=postgresql://eyt_user:replace_with_a_strong_secret@db:5432/eyt_erp

# Internal order channel token (keep secret; never expose to browser/mobile clients)
EYT_ERP_CHANNEL_TOKEN=replace_with_a_long_random_channel_token

# Rubika Workshop Gateway
# Keep this separate from the Rubika Bot Token. Never commit the real value.
RUBIKA_WORKSHOP_WEBHOOK_SECRET=replace_with_a_long_random_secret
